# 复制为 .env.local 后填写（.env.local 不要提交到 Git）
# 配置后需重启 dev：pnpm dev

# 视频任务 AIGC 创建（必填，与上游 callback_url 一致）
AIGC_CALLBACK_URL=http://havetea.top:38888/callback
AIGC_USER_ID=1421411324121972938

# 可选
# AIGC_APP_ID=arena
# AIGC_TENANT_ID=arena
# AIGC_MODEL_VERSION_ID=kling-video-o1

# IMA Pro（独立接口，可按需覆盖默认值）
# IMA_PRO_CREATE_URL=https://nexus.fashionlabs.cn/api/v1/aigc/task/create
# IMA_PRO_QUERY_URL=https://nexus.fashionlabs.cn/api/v1/task/detail/query/{task_id}
# IMA_PRO_API_KEY=your_sk_here
# IMA_PRO_MODEL_VERSION_ID=ima-pro
# IMA_PRO_CALLBACK_URL=http://47.89.173.41:22356
# IMA_PRO_USER_ID=pg001
# IMA_PRO_TENANT_ID=pgtest
# IMA_PRO_APP_ID=photogrid

# Doubao 资产审核（点击“生成15s视频”时先审核图片）
# DOUBAO_ASSET_BASE_URL=https://nexus.fashionlabs.cn
# DOUBAO_ASSET_API_KEY=your_sk_here
# DOUBAO_ASSET_GROUP_ID=group-xxxx
# DOUBAO_ASSET_GROUP_NAME=ugc-video-review-assets
# DOUBAO_ASSET_PROJECT_NAME=default
# DOUBAO_ASSET_UID=pg001
